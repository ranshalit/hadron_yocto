{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Remote debug hello (gdbserver on Hadron)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/${config:hadron.appBinary}",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerPath": "${config:hadron.sdkRoot}/sysroots/x86_64-pokysdk-linux/usr/bin/aarch64-poky-linux/aarch64-poky-linux-gdb",
      "miDebuggerServerAddress": "${config:hadron.deviceIp}:1234",
      "preLaunchTask": "deploy-and-start-gdbserver",
      "stopAtEntry": true,
      "setupCommands": [
        {
          "description": "Point GDB at the SDK sysroot (loads libc/libstdc++ .debug symbols)",
          "text": "set sysroot ${config:hadron.sdkRoot}/sysroots/armv8a-poky-linux",
          "ignoreFailures": false
        },
        {
          "description": "Map OS library source paths (glibc, gcc-runtime, ...)",
          "text": "set substitute-path /usr/src/debug ${config:hadron.sdkRoot}/sysroots/armv8a-poky-linux/usr/src/debug",
          "ignoreFailures": false
        },
        {
          "description": "Enable pretty-printing",
          "text": "-enable-pretty-printing",
          "ignoreFailures": true
        }
      ]
    }
  ]
}
